{
  "name": "dsh-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop home for your native DSH web instances",
  "desktopName": "dsh-switcher.desktop",
  "license": "MIT",
  "author": {
    "name": "GCross",
    "email": "176783842+404-GCross@users.noreply.github.com"
  },
  "homepage": "https://github.com/404-GCross/DSH-Switcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/404-GCross/DSH-Switcher.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:real-dsh": "node scripts/test-real-dsh.mjs",
    "test:local-runtime": "node scripts/test-local-runtime.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "check": "npm test && npm run test:release && npm run build",
    "package:linux": "npm run build && electron-builder --linux rpm deb AppImage tar.gz --x64 --publish never",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.468.0",
    "proxy-from-env": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.6",
    "socks-proxy-agent": "^10.1.0",
    "tar": "^7.5.22",
    "ws": "^8.22.2",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/proxy-from-env": "^1.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "io.gcross.dsh-switcher",
    "productName": "DSH Switcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/main/supervisor.cjs"
    ],
    "extraResources": [
      {
        "from": "build/dsh-windows.png",
        "to": "icon.png"
      },
      {
        "from": "build/DEEPSEEK-LICENSE",
        "to": "DEEPSEEK-LICENSE"
      }
    ],
    "npmRebuild": false,
    "linux": {
      "icon": "build/dsh-windows.png",
      "target": [
        "rpm",
        "deb",
        "AppImage",
        "tar.gz"
      ],
      "extraFiles": [
        {
          "from": "build/linux/AppRun",
          "to": "AppRun"
        }
      ],
      "category": "Development",
      "executableName": "dsh-switcher",
      "syncDesktopName": true,
      "maintainer": "GCross <176783842+404-GCross@users.noreply.github.com>",
      "synopsis": "Multi-server DeepSeek Harness desktop client",
      "desktop": {
        "entry": {
          "StartupWMClass": "dsh-switcher",
          "Keywords": "DSH;DeepSeek;AI;Development;"
        }
      }
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "nspr",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "alsa-lib",
        "mesa-libgbm",
        "libsecret"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libnspr4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libasound2t64 | libasound2 (>= 1.0.17)",
        "libgbm1",
        "libsecret-1-0"
      ]
    },
    "appImage": {
      "executableArgs": []
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "win": {
      "icon": "build/dsh-windows.png",
      "target": [
        "zip"
      ],
      "signExecutable": false
    },
    "mac": {
      "icon": "build/dsh-macos.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "artifactName": "DSH-Switcher-${version}-${os}-${arch}.${ext}"
  }
}
