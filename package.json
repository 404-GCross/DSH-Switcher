{
  "name": "dsh-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop home for your native DSH web instances",
  "license": "MIT",
  "author": {
    "name": "GCross",
    "email": "176783842+404-GCross@users.noreply.github.com"
  },
  "homepage": "https://github.com/404-GCross/DSH-Switcher-Client",
  "repository": {
    "type": "git",
    "url": "https://github.com/404-GCross/DSH-Switcher-Client.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:real-dsh": "node scripts/test-real-dsh.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "check": "npm test && npm run test:release && npm run build",
    "package:linux": "npm run build && electron-builder --linux rpm tar.gz --x64 --publish never",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "io.gcross.dsh-switcher",
    "productName": "DSH Switcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "linux": {
      "target": [
        "rpm",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "dsh-switcher",
      "maintainer": "GCross <176783842+404-GCross@users.noreply.github.com>",
      "synopsis": "Multi-server DeepSeek Harness desktop client",
      "desktop": {
        "entry": {
          "StartupWMClass": "dsh-switcher",
          "Keywords": "DSH;DeepSeek;AI;Development;"
        }
      }
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "nspr",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "alsa-lib",
        "mesa-libgbm",
        "libsecret"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "win": {
      "target": [
        "zip"
      ],
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "artifactName": "DSH-Switcher-${version}-${os}-${arch}.${ext}"
  }
}
